# Copy to .env (never commit .env). Only needed for the LLM planner / explainer.
NVIDIA_API_KEY=          # primary provider (NVIDIA NIM)
GROQ_API_KEY=            # fallback provider (Groq)
CEREBRAS_API_KEY=        # fallback provider (Cerebras), generous free tier
# NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# GUARDIANTX_MODEL=nvidia/nemotron-3-ultra-550b-a55b      # any NIM model with tool/function calling
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=openai/gpt-oss-120b
# CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
# CEREBRAS_MODEL=gpt-oss-120b                         # any Cerebras model with tool/function calling
# GUARDIANTX_PROVIDERS=nim,cerebras,groq            # fallback order
# GUARDIANTX_TEMPERATURE=0.2
# GUARDIANTX_TOP_P=0.7
# GUARDIANTX_SEED=2026                               # honoured by some NIM models only
# GUARDIANTX_PRICE_IN=0                              # USD per 1M tokens, for E6 cost reporting
# GUARDIANTX_PRICE_OUT=0
# Phase-1 real-RPC simulation (needs `pip install web3` and a running anvil)
# GUARDIANTX_RPC_URL=http://127.0.0.1:8545